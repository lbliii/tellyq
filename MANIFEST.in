include README.md CONTRIBUTING.md CHANGELOG.md AGENTS.md
include .python-version uv.lock
recursive-include docs *.md
recursive-include examples *.json
recursive-include scripts *.py
recursive-include tests *.py
recursive-include tests/fixtures/cast *.json *.md
recursive-include tests/fixtures/lifecycle *.jsonl *.md
recursive-include tests/fixtures/handoff *.jsonl *.md
include tellyq/py.typed
prune runtime
prune logs
prune .venv
global-exclude *.py[cod] .DS_Store
