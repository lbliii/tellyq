{
  "provenance": "synthetic; hand-authored; no device capture",
  "cases": [
    {
      "name": "receiver session",
      "message": {"type": "RECEIVER_STATUS", "status": {"applications": [{"appId": "synthetic-youtube", "displayName": "YouTube", "sessionId": "synthetic-session-a", "customData": {"screenId": "synthetic-pairing-token"}}], "isActiveInput": true, "isStandBy": false}},
      "expected": {"kind": "receiver", "app_id": "synthetic-youtube", "app_name": "YouTube", "app_session_id": "synthetic-session-a", "active_input": true, "standby": false}
    },
    {
      "name": "playing first position",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "PLAYING", "currentTime": 10, "media": {"contentId": "synthetic-episode-a", "duration": 120, "metadata": {"title": "Synthetic Episode"}}}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": "synthetic-episode-a", "title": "Synthetic Episode", "player_state": "PLAYING", "position": 10.0, "duration": 120.0, "idle_reason": null, "ad_break": null}
    },
    {
      "name": "playing later position without repeated metadata",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "PLAYING", "currentTime": 12}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": null, "title": null, "player_state": "PLAYING", "position": 12.0, "duration": null, "idle_reason": null, "ad_break": null}
    },
    {
      "name": "buffering at nominal duration",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "BUFFERING", "currentTime": 120, "media": {"duration": 120}}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": null, "title": null, "player_state": "BUFFERING", "position": 120.0, "duration": 120.0, "idle_reason": null, "ad_break": null}
    },
    {
      "name": "ad break",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "PLAYING", "currentTime": 120, "breakStatus": {"breakId": "synthetic-break", "currentBreakTime": 0}}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": null, "title": null, "player_state": "PLAYING", "position": 120.0, "duration": null, "idle_reason": null, "ad_break": true}
    },
    {
      "name": "pause",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "PAUSED", "currentTime": 119}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": null, "title": null, "player_state": "PAUSED", "position": 119.0, "duration": null, "idle_reason": null, "ad_break": null}
    },
    {
      "name": "explicit end marker",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": 101, "playerState": "IDLE", "idleReason": "FINISHED", "currentTime": 120, "media": {"contentId": "synthetic-episode-a"}}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": 101, "content_id": "synthetic-episode-a", "title": null, "player_state": "IDLE", "position": 120.0, "duration": null, "idle_reason": "FINISHED", "ad_break": null}
    },
    {
      "name": "empty media",
      "message": {"type": "MEDIA_STATUS", "status": []},
      "expected": {"kind": "media", "empty_status": true}
    },
    {
      "name": "malformed media containers",
      "message": {"type": "MEDIA_STATUS", "status": [{"mediaSessionId": true, "playerState": ["PLAYING"], "currentTime": "120", "media": ["invalid"], "breakStatus": {"breakId": 5}}]},
      "expected": {"kind": "media", "empty_status": false, "media_session_id": null, "content_id": null, "title": null, "player_state": null, "position": null, "duration": null, "idle_reason": null, "ad_break": null}
    },
    {
      "name": "load error",
      "message": {"type": "LOAD_FAILED", "reason": "LOAD_FAILED", "detailedErrorCode": 104, "customData": {"token": "synthetic-pairing-token"}},
      "expected": {"kind": "error", "type": "LOAD_FAILED", "reason": "LOAD_FAILED", "code": 104}
    },
    {
      "name": "replacement app session",
      "message": {"type": "RECEIVER_STATUS", "status": {"applications": [{"appId": "synthetic-other", "displayName": "Synthetic Other App", "sessionId": "synthetic-session-b"}]}},
      "expected": {"kind": "receiver", "app_id": "synthetic-other", "app_name": "Synthetic Other App", "app_session_id": "synthetic-session-b", "active_input": null, "standby": null}
    },
    {
      "name": "malformed receiver is not an app exit",
      "message": {"type": "RECEIVER_STATUS", "status": {"applications": [{}]}},
      "expected": {"kind": "error", "type": "INVALID_RECEIVER_STATUS", "reason": "INVALID_APPLICATION_IDENTITY", "code": null}
    },
    {
      "name": "empty receiver",
      "message": {"type": "RECEIVER_STATUS", "status": {"applications": []}},
      "expected": {"kind": "receiver", "app_id": null, "app_name": null, "app_session_id": null, "active_input": null, "standby": null},
      "expected_callback": {"kind": "error", "type": "INVALID_RECEIVER_STATUS", "reason": "UNCORRELATED_APP_ABSENCE", "code": null}
    }
  ]
}
